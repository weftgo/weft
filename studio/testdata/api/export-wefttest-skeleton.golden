// Generated by weft Studio's "save as test" from run "r_fx". Edit freely: it is yours now.
//
// Agent:       "orders"
// Run:         "r_fx"
// Model:       "wefttest/glm-a"
// Prompt:      "refund order 42"
// Recorded on: (date)
// Steps:       3
// Step 2 replays from the compacted view (compaction 5, made at step 2: seq [1, 3) replaced by 1 entries, hash "f7f974691e358826798016f537798494fdc08c45bce009893a273b3cf26bd1c3").
// The last step's tool calls never ran in the recording (parked, or ended by a stop
// condition): their stubs answer with an error, and StepCountIs(3) ends the replay
// right after, so no request sees those answers.
//
// Drop this file and testdata/ into the package that builds the agent, and rename
// the package clause to that package's name plus _test. The fixtures live in
// testdata/TestReplay_r_fx/, named after the test: rename the test and rename the directory.
// wefttest.Replay answers every model call from the fixture keyed on its request
// (messages, tool names, thinking, tool choice, the sequential flag; never the
// system prompt), so the test passes as long as the requests stay the recorded
// ones. The tools below are stubs answering with the recorded results: swap in
// the real tools and agent, and a changed request fails with wefttest.ErrNoFixture
// naming it. Re-record with wefttest.Record.
package orders_test

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"testing"

	"github.com/weftgo/weft"
	"github.com/weftgo/weft/wefttest"
)

// TestReplay_r_fx replays run "r_fx" of agent "orders" from its fixtures.
func TestReplay_r_fx(t *testing.T) {
	const fixtures = "testdata/TestReplay_r_fx"

	// requestMessages reads one fixture's request messages back.
	requestMessages := func(file string) ([]weft.Message, error) {
		b, err := os.ReadFile(file)
		if err != nil {
			return nil, err
		}
		var fx struct {
			Request struct {
				Messages []weft.Message `json:"messages"`
			} `json:"request"`
		}
		if err := json.Unmarshal(b, &fx); err != nil {
			return nil, fmt.Errorf("%s: %w", file, err)
		}
		return fx.Request.Messages, nil
	}

	// The results the run recorded, by step and call id (a provider may
	// reuse a call id across steps): fixture k+1's request ends with step
	// k's reply and the tool results that answered it.
	files, err := filepath.Glob(filepath.Join(fixtures, "*.json"))
	if err != nil || len(files) == 0 {
		t.Fatalf("no fixtures in %s: %v", fixtures, err)
	}
	type stepCall struct {
		step int
		id   string
	}
	recorded := map[stepCall]weft.ToolResultPart{}
	for k, f := range files[1:] { // files sort in step order
		msgs, err := requestMessages(f)
		if err != nil {
			t.Fatal(err)
		}
		last := -1
		for i, m := range msgs {
			if m.Role == weft.RoleAssistant {
				last = i
			}
		}
		for _, m := range msgs[last+1:] {
			for _, part := range m.Content {
				if r, ok := part.(weft.ToolResultPart); ok {
					recorded[stepCall{k, r.CallID}] = r
				}
			}
		}
	}
	// answer is every stub's handler: the recorded result for the call,
	// an error result exactly as the run recorded it.
	answer := func(ctx context.Context, _ json.RawMessage) (string, error) {
		call, _ := weft.CallFromContext(ctx)
		r, ok := recorded[stepCall{call.Step, call.CallID}]
		switch {
		case !ok:
			return "", errors.New("no recorded result for call " + call.CallID + " (the recording never ran it)")
		case r.IsError:
			return "", errors.New(r.Content)
		}
		return r.Content, nil
	}
	const stub = "recorded tool: replace with the real one"
	tools := map[string]*weft.ToolDef{
		"lookup_order": weft.RawTool("lookup_order", stub, nil, answer),
		"refund":       weft.RawTool("refund", stub, nil, answer),
		"research":     weft.RawTool("research", stub, nil, answer),
	}

	opts := []weft.Option{
		weft.Name("orders"),
		weft.Instructions("You are a support agent."),
		weft.MaxSteps(3),
		weft.StopWhen(weft.StepCountIs(3)), // the recorded run's length
		weft.MaxResultBytes(0),             // the recorded results are already capped
	}
	for _, name := range []string{"lookup_order", "refund", "research"} {
		opts = append(opts, tools[name])
	}
	// The steps whose request differed from the agent's defaults.
	opts = append(opts, weft.PrepareStep(func(_ context.Context, step int, req weft.ModelRequest) (weft.ModelRequest, error) {
		switch step {
		case 2:
			// Step 2 replays from the compacted view: its request carried
			// the view, not the plain transcript.
			view, err := requestMessages("testdata/TestReplay_r_fx/00003-c543200256d8d724.json")
			if err != nil {
				return req, err
			}
			req.Messages = view
		}
		return req, nil
	}))
	agt := weft.New(wefttest.Replay(t, "testdata"), opts...)

	res, err := agt.Generate(context.Background(), weft.Prompt("refund order 42"))
	if err != nil {
		t.Fatalf("replay: %v", err)
	}
	if got, want := len(res.Steps), 3; got != want {
		t.Errorf("steps = %d, want %d", got, want)
	}
	if got, want := res.Text(), ""; got != want {
		t.Errorf("final text = %q, want %q", got, want)
	}
}
