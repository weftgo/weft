{
  "name": "@weftgo/devtools",
  "version": "0.13.0",
  "description": "The weft devtools panel: the same bytes as /studio/panel.js, as an ES module, with typed mount/scope/open/close/on and thin React, Vue and Svelte helpers.",
  "keywords": [
    "weft",
    "devtools",
    "agents",
    "llm",
    "observability",
    "studio",
    "react",
    "vue",
    "svelte"
  ],
  "homepage": "https://github.com/weftgo/weft/tree/main/studio#readme",
  "bugs": {
    "url": "https://github.com/weftgo/weft/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weftgo/weft.git",
    "directory": "studio/web/npm"
  },
  "type": "module",
  "sideEffects": [
    "./panel.js",
    "./index.js",
    "./ssr-guard.js",
    "./ssr-unguard.js"
  ],
  "types": "./types/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/npm/index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./types/npm/react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./types/npm/vue.d.ts",
      "default": "./vue.js"
    },
    "./svelte": {
      "types": "./types/npm/svelte.d.ts",
      "default": "./svelte.js"
    },
    "./scope": {
      "types": "./types/lib/scope.d.ts",
      "default": "./scope.js"
    },
    "./panel.js": {
      "types": "./types/npm/panel.d.ts",
      "default": "./panel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "panel.js.sha256",
    "types/"
  ],
  "scripts": {
    "prepublishOnly": "bun ../scripts/npm-package.ts --check"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=3",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
